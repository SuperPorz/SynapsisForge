# ── ENV FILE TEMPLATE ──────────────────────────────────────────────
# Copy this file to:
#   .env.development  (for local dev)
#   .env.production   (for production / EC2)
# Both are gitignored. Keep production secrets backed up securely.
# ───────────────────────────────────────────────────────────────────

# App
NODE_ENV=production
FRONTEND_URL=https://<your-domain>.com

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=<username>
DB_PASSWORD=<password>
DB_DATABASE=<database>

# MongoDB
# ⚠️ MONGO_USER/MONGO_PASS non devono contenere @ : / % — rompono l'URI Mongoose
# Usare credenziali semplici (es. admin / mongopass)
MONGO_URI=mongodb://localhost:27017/mongo_synapsis
MONGO_USER=
MONGO_PASS=

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# AWS S3
AWS_REGION=eu-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_MEDIA_BUCKET=synapsisforge-media
S3_PRIVATE_BUCKET=synapsisforge-private
USE_S3=false

# Demo admin (default credentials for local dev — override via GitHub Secrets in prod)
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=Password123!

# Braintree
BRAINTREE_MERCHANT_ID=
BRAINTREE_PUBLIC_KEY=
BRAINTREE_PRIVATE_KEY=
