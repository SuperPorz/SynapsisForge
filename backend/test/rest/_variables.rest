# ============================================================
# _variables.rest — Variabili condivise per tutti i file .rest
# ============================================================
# NOTA: Il REST Client di VS Code NON supporta variabili cross-file.
# Questo file serve come riferimento centralizzato: copia i valori
# nei singoli file, oppure usa lo script `npm run sync-ids` per
# aggiornarli automaticamente dopo ogni reset del DB.
# ============================================================

@baseUrl = http://localhost:3000

# ── Auth ────────────────────────────────────────────────────
# Ottenuti via POST /auth/login — aggiornare dopo ogni login
@adminToken    = ADMIN_JWT_TOKEN
@studentToken  = STUDENT_JWT_TOKEN
@instructorToken = INSTRUCTOR_JWT_TOKEN

# ── Users ───────────────────────────────────────────────────
@adminId       = ADMIN_UUID
@studentId     = 37050184-3d3d-47df-94de-4a327909d348
@instructorId  = c781d654-2965-4c1b-ad75-0f730abe7a92

# ── Courses ─────────────────────────────────────────────────
@courseId      = 4215d6de-99ee-4d84-8115-decf48ab3e7a
@categoryId    = 556c19d1-b9a1-486b-b0d2-8afcf607ea2b
@slug          = nestjs-a-z

# ── Lessons ─────────────────────────────────────────────────
@lessonId      = LESSON_UUID

# ── Enrollments ─────────────────────────────────────────────
@enrollmentId  = 0558d9cf-c4be-496e-b0dd-13413bcf42b0

# ── Certificates ────────────────────────────────────────────
