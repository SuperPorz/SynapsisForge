DB_HOST=localhost
DB_PORT=5432
DB_USER=user
DB_PASS=123
DB_NAME=project_database

MONGO_URI=mongodb://localhost:27017/<nome_mongo_database>
MONGO_USER=user
MONGO_PASS=123
MONGO_AUTH_SOURCE=admin #per cambiare credenziali andare sul docker-compose

JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# Redis — caching, rate limiting, session store
REDIS_URL=redis://localhost:6379

# Amazon S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET_NAME=

# S3 — impostare a true solo quando AWS è configurato
USE_S3=false