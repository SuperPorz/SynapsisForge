# ── Docker Compose credentials ────────────────────────────────────
# Copy this file as .env.compose and fill with your production values.
# Run: docker compose --env-file infra/.env.compose -f infra/docker-compose.prod.yml up -d
# ──────────────────────────────────────────────────────────────────

# Database credentials (used by both the apps and the DB containers)
DB_USERNAME=admin
DB_PASSWORD=qwerty
DB_DATABASE=pg_database
DB_HOST=postgres
DB_PORT=5432

# MongoDB
MONGO_USER=admin
MONGO_PASS=qwerty
MONGO_URI=mongodb://admin:qwerty@mongodb:27017/mongo_synapsis

# Redis
REDIS_URL=redis://redis:6379

# URLs
FRONTEND_URL=https://synapsisforge.shop
GOOGLE_CALLBACK_URL=https://synapsisforge.shop/api/auth/google/callback
GITHUB_CALLBACK_URL=https://synapsisforge.shop/api/auth/github/callback
